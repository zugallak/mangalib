# Supabase — create a NEW, dedicated Supabase project for this app.
# Project Settings → API

# Public client config (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Accepts either the legacy anon key or the newer publishable key
# (sb_publishable_...). Either value goes here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
# Used for controlled, catalog-management server logic (scan import creates
# shared catalog rows via this) — NOT for normal user reads/writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Bookshelf scan (AI) — server-only. NEVER prefix with NEXT_PUBLIC_. ---
# Gemini is the primary scanner; OpenAI is the technical fallback.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Optional model overrides. If unset, defaults are used:
#   GEMINI_MODEL=gemini-3.6-flash   (pinned stable Flash model)
#   OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=
# OPENAI_MODEL=
