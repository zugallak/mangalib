# Supabase — create a NEW, dedicated Supabase project for this app.
# Project Settings → API

# Public client config (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Accepts either the legacy anon key or the newer publishable key
# (sb_publishable_...). Either value goes here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
# Used only for future controlled, catalog-management server logic — NOT for
# normal user reads/writes. Leave set but unused for now.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
